[Unit]
Description=Welcome page for the print server (printer status and links)
After=network-online.target cups.service

[Service]
# Throwaway system user; only needs to bind port 80 (and UDP 1900 for SSDP), run lpstat, read /sys,
# and query the firmware via vcgencmd (/dev/vchiq is group "video")
DynamicUser=yes
SupplementaryGroups=video
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/python3 /usr/local/bin/welcome.py
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
Nice=5

[Install]
WantedBy=multi-user.target
