[Unit]
Description=Web page for scanning on the HP DeskJet
After=network-online.target cups.service

[Service]
User=scanweb
Group=scanweb
SupplementaryGroups=lp scanner
ExecStart=/usr/bin/python3 /usr/local/bin/scanweb.py
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
Nice=5

[Install]
WantedBy=multi-user.target
